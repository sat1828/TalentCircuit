# Database
DATABASE_URL=postgresql://talentcircuit:talentcircuit@localhost:5432/talentcircuit

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_REFRESH_SECRET=change-me-too-min-32-chars-long
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Anthropic/Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small

# SMTP (for digest emails)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
DIGEST_FROM=noreply@talentcircuit.com

# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Company (for seed/single-tenant mode)
COMPANY_NAME=TalentCircuit Demo
COMPANY_DOMAIN=talentcircuit-demo.com
